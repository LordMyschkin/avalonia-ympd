<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModernYmpd.AboutDialog"
        Title="About A-mpd"
        Icon="avares://ModernYmpd/Assets/app.ico"
        Width="540" Height="385" MinWidth="540" MinHeight="385"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#10151D" Foreground="#EEF2F5">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28" RowSpacing="20">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <Border Width="48" Height="48" CornerRadius="14" Background="#B8F36B">
        <TextBlock Text="▶" Foreground="#172316" FontSize="21" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="A-mpd" FontSize="23" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Foreground="#B8F36B" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="12">
      <TextBlock Text="From the ympd web player to a standalone Avalonia app: born from the idea of bringing ympd and ashuffle together in one interface."
                 TextWrapping="Wrap" />
      <TextBlock Text="Vibe-coded with OpenAI Codex and expanded step by step."
                 Foreground="#A9B7C4" TextWrapping="Wrap" />
      <Border Background="#1A222E" BorderBrush="#303B49" BorderThickness="1"
              CornerRadius="10" Padding="14,12">
        <TextBlock Text="The app controls MPD directly, can fill the queue with random tracks from the MPD library, and supports macOS media keys."
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Button Grid.Row="2" Content="Close" Click="Close_Click"
            HorizontalAlignment="Right" Background="#B8F36B" Foreground="#172316"
            FontWeight="Bold" Padding="18,9" CornerRadius="9" />
  </Grid>
</Window>
