<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModernYmpd.ExitDialog"
        Title="Quit A-mpd"
        Width="510" Height="238" MinWidth="510" MinHeight="238"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#17212C" Foreground="#EEF2F5">
  <Window.Styles>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#B8F36B" />
      <Setter Property="Foreground" Value="#172316" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="14">
    <TextBlock Text="Pause MPD before quitting?" FontSize="20" FontWeight="Bold" />
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="A-mpd will close and stop filling the queue. MPD keeps its current playback and queue unless you pause it."
                 TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorText" Foreground="#FFAA9A" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Quit without pausing" Click="Quit_Click" />
      <Button x:Name="PauseButton" Classes="accent" Content="Pause MPD and quit" Click="PauseAndQuit_Click" />
    </StackPanel>
  </Grid>
</Window>
